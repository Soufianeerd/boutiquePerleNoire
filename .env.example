# ==============================================================================
# PERLE NOIRE - CONFIGURATION ENVIRONNEMENT
# ==============================================================================

# Next.js Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# Supabase (PostgreSQL & Auth & Storage)
# Remplacer par vos identifiants Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage Bucket
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=jewelry-media

# Stripe (Paiements sécurisés - mode test initial)
STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Resend (E-mails transactionnels)
RESEND_API_KEY=re_placeholder
CONTACT_NOTIFICATION_EMAIL=atelier@perlenoire-joaillerie.fr
